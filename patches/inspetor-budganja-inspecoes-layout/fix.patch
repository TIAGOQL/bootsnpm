 .install-prompt-main {
@@ -12196,12 +12198,55 @@ body[data-page="comunidade"] .botao.botao-outline:focus-visible {
 /* Hub no modelo /videos/: chips + busca + lista filtrada */
 .inspecoes-hub .videos-filters-wrap {
     margin-top: 4px;
+    margin-bottom: 16px;
+}
+
+/* Chips: scroll horizontal no mobile; wrap controlado no desktop */
+.inspecoes-hub .videos-filters {
+    display: flex;
+    flex-wrap: nowrap;
+    gap: 8px;
+    overflow-x: auto;
+    overflow-y: hidden;
+    -webkit-overflow-scrolling: touch;
+    scrollbar-width: thin;
+    padding: 2px 2px 8px;
+    max-width: 100%;
+}
+
+.inspecoes-hub .videos-filter-chip {
+    flex: 0 0 auto;
+    white-space: nowrap;
+}
+
+@media (min-width: 900px) {
+    .inspecoes-hub .videos-filters {
+        flex-wrap: wrap;
+        overflow-x: visible;
+        padding-bottom: 2px;
+    }
+}
+
+.inspecoes-hub .videos-search-wrap,
+.inspecoes-hub .inspecoes-search-wrap {
+    max-width: none;
+    width: 100%;
+    margin-bottom: 20px;
 }
 
 .inspecoes-list {
     margin-top: clamp(8px, 1.5vw, 14px);
 }
 
+/* Espaço para o banner «Instalar app» não cobrir cards */
+body[data-page="inspecoes"] #main-content {
+    padding-bottom: calc(var(--space-section, 48px) + 72px + env(safe-area-inset-bottom, 0px));
+}
+
+body:has(.install-prompt:not(.is-hidden)) #main-content {
+    padding-bottom: calc(var(--space-section, 48px) + 80px + env(safe-area-inset-bottom, 0px));
+}
+
 .inspecoes-list .inspecoes-tipo-section {
     scroll-margin-top: calc(var(--header-offset, 72px) + 12px);
 }
